CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# Keep the esp32-camera default (internal DMA buffer + PSRAM frame buffers).
# PSRAM direct-DMA mode reports NO-SOI / DMA overflow for JPEG captures:
# https://github.com/espressif/esp32-camera/issues/775
# CONFIG_CAMERA_PSRAM_DMA is not set
CONFIG_OV5640_SUPPORT=y
CONFIG_OV2640_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The ESP-IDF partition table occupies 0x8000..0x8FFF; keep the
# standard NVS/PHY offsets at 0x9000/0xF000 below.
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_HTTP_SERVER_MAX_REQ_HDR_LEN=1024
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_PEDESTRIAN_DETECT_PICO_S8_V1=y
CONFIG_PEDESTRIAN_DETECT_PICO_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_HUMAN_FACE_FEAT_MFN_S8_V1=y
CONFIG_HUMAN_FACE_FEAT_MFN_S8_V1=y
# USB UVC webcam on the OTG Type-C port (espressif/usb_device_uvc).
# Full-speed internal PHY is the ESP32-S3 OTG port (GPIO19/20).
CONFIG_TINYUSB_RHPORT_FS=y
# Friendly name shown by the PC when the camera is opened.
CONFIG_TUSB_MANUFACTURER="DeskFriend"
CONFIG_TUSB_PRODUCT="DeskFriend Camera"
CONFIG_TUSB_SERIAL_NUM="DF-CAM-01"
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_ISOC_CAM1=y
# Advertise four host-selectable modes. QVGA is the default (fast Wi-Fi stream
# and inference); the vision task applies a host's choice by reinitializing the
# sensor between frames, so Wi-Fi and the face pipeline follow the same geometry.
CONFIG_FRAMESIZE_QVGA=y
CONFIG_UVC_CAM1_FRAMERATE=15
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
# Multi-frame slot 1: VGA 640x480. Full-speed isochronous tops out near
# 512 KB/s, so 10 fps is realistic for ~40 KB MJPEG frames.
CONFIG_UVC_MULTI_FRAME_WIDTH_1=640
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=480
CONFIG_UVC_MULTI_FRAME_FPS_1=10
# Multi-frame slot 2: HVGA 480x320.
CONFIG_UVC_MULTI_FRAME_WIDTH_2=480
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=320
CONFIG_UVC_MULTI_FRAME_FPS_2=15
# Multi-frame slot 3: SVGA 800x600. Useful for stills/post-processing; the
# ESP-DL pipeline runs well below 5 fps at this size.
CONFIG_UVC_MULTI_FRAME_WIDTH_3=800
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=600
CONFIG_UVC_MULTI_FRAME_FPS_3=5
# Keep USB work off core 1 so face detection keeps its core.
CONFIG_UVC_TINYUSB_TASK_CORE=0
CONFIG_UVC_CAM1_TASK_CORE=0
